{
  "petTypeId": "ginger-cat",
  "callOutAnimation": "walk",
  "goToSleepAnimation": "walk",
  "followAnimation": "walk",
  "dragOffset": { "x": 20, "y": 20 },
  "animations": {
    "idle": {
      "movementSpeed": { "x": 0, "y": 0 },
      "wanderRules": {
        "minSeconds": 5,
        "maxSeconds": 15,
        "nextIntent": ["walk", "sit"]
      },
      "animationTransitions": {
        "walk": { "nextAnimation": "idle-to-walk", "canTurn": true },
        "sit": { "nextAnimation": "idle-to-sit", "canTurn": true }
      }
    },
    "sleep": {
      "movementSpeed": { "x": 0, "y": 0 },
      "animationTransitions": {
        "lounge": { "nextAnimation": "sleep-to-lounge", "canTurn": false }
      }
    },
    "none": {
      "movementSpeed": { "x": 0, "y": 0 },
      "wanderRules": {
        "minSeconds": 0,
        "maxSeconds": 0,
        "nextIntent": ["idle"]
      }
    },
    "walk": {
      "movementSpeed": { "x": 0.8, "y": 0 },
      "wanderRules": {
        "minSeconds": 3,
        "maxSeconds": 8,
        "nextIntent": ["idle", "sit"]
      },
      "animationTransitions": {
        "idle": { "nextAnimation": "walk-to-idle", "canTurn": true },
        "sit": { "nextAnimation": "idle-to-sit", "canTurn": false }
      }
    },
    "sit": {
      "movementSpeed": { "x": 0, "y": 0 },
      "wanderRules": {
        "minSeconds": 10,
        "maxSeconds": 180,
        "nextIntent": ["idle", "lounge", "walk", "sit&lookBack"]
      },
      "animationTransitions": {
        "idle": { "nextAnimation": "sit-to-idle", "canTurn": false },
        "lounge": { "nextAnimation": "sit-to-lounge", "canTurn": false },
        "walk": { "nextAnimation": "sit-to-idle", "canTurn": false },
        "sit&lookBack": {
          "nextAnimation": "sit-to-sit&lookBack",
          "canTurn": false
        }
      }
    },
    "groom": {
      "movementSpeed": { "x": 0, "y": 0 },
      "wanderRules": {
        "minSeconds": 8,
        "maxSeconds": 15,
        "nextIntent": ["lounge"]
      },
      "animationTransitions": {
        "lounge": { "nextAnimation": "groom-to-lounge", "canTurn": false }
      }
    },
    "lounge": {
      "movementSpeed": { "x": 0, "y": 0 },
      "wanderRules": {
        "minSeconds": 20,
        "maxSeconds": 300,
        "nextIntent": ["groom", "sit", "sleep", "lounge&lookBack"]
      },
      "animationTransitions": {
        "groom": { "nextAnimation": "lounge-to-groom", "canTurn": false },
        "sit": { "nextAnimation": "lounge-to-sit", "canTurn": false },
        "sleep": { "nextAnimation": "lounge-to-sleep", "canTurn": false },
        "lounge&lookBack": {
          "nextAnimation": "lounge-to-lounge&lookBack",
          "canTurn": false
        }
      }
    },
    "lounge&lookBack": {
      "movementSpeed": { "x": 0, "y": 0 },
      "wanderRules": {
        "minSeconds": 4,
        "maxSeconds": 6,
        "nextIntent": ["lounge"]
      },
      "animationTransitions": {
        "lounge": {
          "nextAnimation": "lounge&lookBack-to-lounge",
          "canTurn": false
        }
      }
    },
    "sit&lookBack": {
      "movementSpeed": { "x": 0, "y": 0 },
      "wanderRules": {
        "minSeconds": 4,
        "maxSeconds": 6,
        "nextIntent": ["sit"]
      },
      "animationTransitions": {
        "sit": { "nextAnimation": "sit&lookBack-to-sit", "canTurn": false }
      }
    },
    "idle-to-walk": {
      "movementSpeed": { "x": 0.4, "y": 0 },
      "animationTransitions": {
        "walk": { "nextAnimation": "walk", "canTurn": false }
      }
    },
    "idle-to-sit": {
      "movementSpeed": { "x": 0, "y": 0 },
      "animationTransitions": {
        "sit": { "nextAnimation": "sit", "canTurn": false }
      }
    },
    "sleep-to-lounge": {
      "movementSpeed": { "x": 0, "y": 0 },
      "animationTransitions": {
        "lounge": { "nextAnimation": "lounge", "canTurn": false }
      }
    },
    "walk-to-idle": {
      "movementSpeed": { "x": 0.4, "y": 0 },
      "animationTransitions": {
        "idle": { "nextAnimation": "idle", "canTurn": false }
      }
    },
    "sit-to-idle": {
      "movementSpeed": { "x": 0, "y": 0 },
      "animationTransitions": {
        "idle": { "nextAnimation": "idle", "canTurn": true },
        "walk": { "nextAnimation": "walk", "canTurn": true }
      }
    },
    "sit-to-lounge": {
      "movementSpeed": { "x": 0, "y": 0 },
      "animationTransitions": {
        "lounge": { "nextAnimation": "lounge", "canTurn": false }
      }
    },
    "sit-to-sit&lookBack": {
      "movementSpeed": { "x": 0, "y": 0 },
      "animationTransitions": {
        "sit&lookBack": { "nextAnimation": "sit&lookBack", "canTurn": false }
      }
    },
    "sit&lookBack-to-sit": {
      "movementSpeed": { "x": 0, "y": 0 },
      "animationTransitions": {
        "sit": { "nextAnimation": "sit", "canTurn": false }
      }
    },
    "lounge-to-groom": {
      "movementSpeed": { "x": 0, "y": 0 },
      "animationTransitions": {
        "groom": { "nextAnimation": "groom", "canTurn": false }
      }
    },
    "lounge-to-sit": {
      "movementSpeed": { "x": 0, "y": 0 },
      "animationTransitions": {
        "sit": { "nextAnimation": "sit", "canTurn": false }
      }
    },
    "lounge-to-sleep": {
      "movementSpeed": { "x": 0, "y": 0 },
      "animationTransitions": {
        "sleep": { "nextAnimation": "sleep", "canTurn": false }
      }
    },
    "lounge-to-lounge&lookBack": {
      "movementSpeed": { "x": 0, "y": 0 },
      "animationTransitions": {
        "lounge&lookBack": {
          "nextAnimation": "lounge&lookBack",
          "canTurn": false
        }
      }
    },
    "lounge&lookBack-to-lounge": {
      "movementSpeed": { "x": 0, "y": 0 },
      "animationTransitions": {
        "lounge": { "nextAnimation": "lounge", "canTurn": false }
      }
    },
    "groom-to-lounge": {
      "movementSpeed": { "x": 0, "y": 0 },
      "animationTransitions": {
        "lounge": { "nextAnimation": "lounge", "canTurn": false }
      }
    }
  }
}
